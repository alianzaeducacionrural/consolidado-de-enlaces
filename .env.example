# ─────────────────────────────────────────────────────────────
#  Consolidado de enlaces — variables de entorno
#  Copia este archivo como .env.local y completa los valores.
# ─────────────────────────────────────────────────────────────

# Usuario u organización de GitHub cuyos repos se listan en el dashboard.
GITHUB_OWNER=alianzaeducacionrural

# (Opcional) Token de GitHub para: subir el límite de la API y ver repos privados.
# Crea uno en https://github.com/settings/tokens con permiso "public_repo" (o "repo" si hay privados).
GITHUB_TOKEN=

# (Opcional pero MUY recomendado) Contraseña para entrar al dashboard.
# Si se define, todo el sitio queda protegido y solo entonces se muestran
# los datos de usuarios/cuentas de cada herramienta.
SITE_PASSWORD=

# (Opcional) Datos de usuarios/cuentas por herramienta, en JSON.
# Alternativa al archivo local data/accounts.local.json (útil para el sitio en Vercel).
# Formato: { "nombre-del-repo": { "nota": "...", "cuentas": [ { "rol": "Admin", "usuario": "...", "clave": "...", "url": "...", "notas": "..." } ] } }
ACCOUNTS_JSON=

# (Opcional) Enriquecimiento de herramientas en JSON, si no quieres editar el
# archivo data/overrides.json en el repo (p. ej. para probar en Vercel sin commit).
# Tiene prioridad sobre data/overrides.json.
OVERRIDES_JSON=
